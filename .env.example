# ---------------------------------------------------------------------------
# autonomous-ultron — example environment. Copy to `.env` and edit.
# `.env` is gitignored. NEVER commit real keys.
# `src/ultron/config.py` only reads ULTRON_* variables plus provider keys that
# LiteLLM needs. Nothing here is ever forwarded into a tool sandbox.
# ---------------------------------------------------------------------------

# --- Which model provider keys exist (leave blank for fully offline mode) ----
# Any single one of these is enough for "live" LLM mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Or route to a local/OpenAI-compatible endpoint (Ollama, vLLM, LM Studio...):
# ULTRON_LLM_API_BASE=http://localhost:11434/v1

# --- Cost architecture: cheap router, cheap judge, mid planner --------------
# Small/fast models only. ULTRON_ROUTER_MODEL decides plan depth; it is the
# single biggest cost lever in the system. Keep it cheap.
ULTRON_ROUTER_MODEL=gpt-4o-mini
ULTRON_PLANNER_MODEL=gpt-4o-mini
ULTRON_JUDGE_MODEL=gpt-4o-mini
ULTRON_SYNTH_MODEL=gpt-4o-mini

# auto    = live if a provider key is present, otherwise offline stubs
# live    = require a key (raises if missing)
# offline = never call a provider (zero LLM call sites are entered)
# stub    = enter every LLM call site but answer deterministically, priced from
#           the real price table — used by CI so the cost gate is not vacuous
ULTRON_LLM_MODE=auto

# CI cost gates: minimum success rate, max avg cost and latency per run
ULTRON_EVAL_MIN_SUCCESS_RATE=0.80
ULTRON_EVAL_MAX_AVG_COST_USD=0.02
ULTRON_EVAL_MAX_AVG_LATENCY_S=20

# --- Budget kill-switch (hard stop per run) --------------------------------
ULTRON_BUDGET_MAX_USD=0.05
ULTRON_BUDGET_MAX_STEPS=6
ULTRON_BUDGET_MAX_SECONDS=120
ULTRON_BUDGET_MAX_LLM_CALLS=12

# --- Network tools: fixtures, or opt-in live egress -------------------------
# ULTRON_WEB_MOCK points the network tools at a local fixture corpus. Tests, CI
# and the eval harness set this themselves; leave it blank unless you want
# fixture mode for interactive runs too.
ULTRON_WEB_MOCK=
# ULTRON_EVAL_LIVE=1 lets web_research/http_fetch reach the real internet, with a
# URL-keyed page cache. Off by default and NEVER enabled by CI: a live run is a
# manual, local decision (and still needs a policy approval for network tools).
ULTRON_EVAL_LIVE=0
# Where the URL-keyed page cache lives in live mode. Local backend only: the
# docker sandbox is read-only in every mode and gets no writable mount, so it
# does not use this cache (the envelope cache still applies to both).
ULTRON_WEB_CACHE=.ultron/webcache/webcache.db

# --- Cache (SQLite; cache hits skip execution AND LLM calls) ---------------
ULTRON_CACHE_PATH=.ultron/cache.db
ULTRON_CACHE_TTL_LLM=86400
ULTRON_CACHE_TTL_TOOL=3600
ULTRON_CACHE_TTL_WEB=900

# --- Executor / sandbox ----------------------------------------------------
# docker = required for anything real. local = UNSAFE dev/CI escape hatch.
ULTRON_SANDBOX=docker
ULTRON_SANDBOX_IMAGE=ultron-tools:phase1
ULTRON_SANDBOX_BUILD_IMAGE=0
ULTRON_SANDBOX_TIMEOUT_S=60
ULTRON_SANDBOX_MEMORY=512m
ULTRON_SANDBOX_CPUS=1
ULTRON_SANDBOX_PIDS=128
# Must be explicitly set to 1 for the `local` backend to run at all.
ULTRON_ALLOW_LOCAL_SANDBOX=0
# Extra host env vars to forward into the sandbox (secrets are never allowed).
ULTRON_ENV_ALLOWLIST=

# --- Policy gate -----------------------------------------------------------
# auto = grant network only when the manifest asks for it; deny = never
ULTRON_POLICY_NETWORK=auto
# DANGER: auto-answers "yes" to MEDIUM risk prompts. Dev only. Never in CI prod.
ULTRON_POLICY_ASSUME_YES=0
ULTRON_APPROVALS_FILE=.ultron/approvals.json
ULTRON_AUDIT_LOG=.ultron/audit.jsonl

# --- Verification ----------------------------------------------------------
# Deterministic checks always run. The LLM judge is opt-in (costs money).
ULTRON_ENABLE_LLM_JUDGE=0
ULTRON_ENABLE_SYNTHESIS=0

# --- State / eval ----------------------------------------------------------
ULTRON_STATE_DIR=.ultron
ULTRON_MEMORY_PATH=.ultron/memory.db
# CI only: price stub LLM calls with the real model price table so the cost
# gate is not vacuous. Reports are labelled cost_basis="simulated".
ULTRON_COST_SIMULATE=0
ULTRON_EVAL_TASKS=eval/tasks.jsonl
ULTRON_EVAL_BASELINE=eval/baseline.json
